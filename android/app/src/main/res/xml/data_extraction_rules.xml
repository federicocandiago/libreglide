<?xml version="1.0" encoding="utf-8"?>
<!-- The app-opening history (database) never leaves the device: it is
     excluded from cloud backup and device-to-device transfer.
     Settings (shared_preferences) may be backed up. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="database" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="database" path="." />
    </device-transfer>
</data-extraction-rules>
