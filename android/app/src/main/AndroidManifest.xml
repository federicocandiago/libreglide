<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Uninstall from the app menu (system confirmation). -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Network type (Wi-Fi, mobile, offline) for context: normal permission, no dialog. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Only for the optional Unsplash wallpaper: without a user-provided key
         libreGLIDE opens no connections (see lib/net/unsplash.dart). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Agenda card: upcoming events. Requested by the card, optional. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Contacts panel (swipe up): favorites and search. Requested by the panel, optional. -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Weather (optional): COARSE location only, rounded before it is sent. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <!-- Places (optional): precise location only while the launcher is in use, to
         tell home from work. Coordinates and Wi-Fi fingerprints stay on the phone. -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- "Where I parked" (optional, off by default): the only background use of
         location, when the phone disconnects from the Bluetooth car stereo. -->
    <uses-permission android:name="android.permission.ACCESS_BACKGROUND_LOCATION" />
    <!-- In-car card (optional): detect the Bluetooth car stereo. -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Usage time (optional, off by default): special access granted by the user
         in Android settings. The data stays on the phone. -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <application
        android:name=".LibreGlideApplication"
        android:label="libreGLIDE"
        android:icon="@mipmap/ic_launcher"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:resumeWhilePausing="true"
            android:excludeFromRecents="true"
            android:taskAffinity=""
            android:theme="@style/LauncherTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <meta-data
                android:name="io.flutter.embedding.android.NormalTheme"
                android:resource="@style/LauncherTheme" />
            <!-- App Home -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- Icon in the app drawer, useful during development and to open settings -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Now Playing card: only needed to access media sessions.
             It neither reads nor stores notifications (see MediaListenerService). -->
        <service
            android:name=".MediaListenerService"
            android:label="libreGLIDE"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
        <!-- Car connect/disconnect, for parking. -->
        <receiver
            android:name=".ParkingReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.bluetooth.device.action.ACL_CONNECTED" />
                <action android:name="android.bluetooth.device.action.ACL_DISCONNECTED" />
            </intent-filter>
        </receiver>
        <!-- Digital detox (optional, off by default): accessibility service enabled
             manually by the user. It only receives the foreground app's name, not
             the screen content (see DetoxService and xml/detox_service.xml). -->
        <service
            android:name=".DetoxService"
            android:label="@string/detox_service_label"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/detox_service" />
        </service>
        <activity
            android:name=".DetoxLockActivity"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="org.libreglide.launcher.detox"
            android:excludeFromRecents="true"
            android:theme="@style/DetoxLockTheme"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|screenLayout|uiMode" />
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>

    <queries>
        <!-- System apps that Digital detox can block (they have no launcher icon). -->
        <package android:name="com.android.settings" />
        <package android:name="com.google.android.packageinstaller" />
        <package android:name="com.android.packageinstaller" />
        <package android:name="com.android.vending" />
        <!-- Visibility of launchable apps (package visibility). -->
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT" />
            <data android:mimeType="text/plain" />
        </intent>
    </queries>
</manifest>
